# .env.dev — local development environment variables for salesdata-api
#
# Loaded automatically by run_api.py via `load_dotenv(".env.dev")`, so this
# file must live at the project root (same directory as run_api.py) and is
# only read by that entrypoint — running via `uvicorn run_api:app` (which
# imports run_api.py) picks it up too, since load_dotenv() runs at import
# time. A bare `uvicorn core.app.api.app:create_app` style invocation that
# never imports run_api.py would NOT load this file; export these into your
# shell instead in that case.
#
# Values below are safe local-dev defaults, not production secrets.
# Regenerate JWT_SECRET_KEY and any admin password before deploying anywhere
# real, and never commit a filled-in .env with production values.

# =============================================================================
# Database (one PostgreSQL database backs everything: application data +
# application state — users, API keys, logs, traces, query cache L2, audit log)
# =============================================================================

# Preferred: a single DSN. If set, this takes precedence over the discrete
# PG*  vars below. Leave blank to use PGHOST/PGPORT/etc. instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Discrete connection params — only used when DATABASE_URL is empty.
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres
# Leave unset/commented for local dev (no SSL) — an empty string is NOT the
# same as unset here and will make psycopg2 fail with
# `invalid sslmode value: ""`. Set to e.g. "require" against a
# managed/remote Postgres instance.
# PGSSLMODE=require

# Application data connection pool sizing (the main query/data path). Unset =
# derived from detected CPU count (core/concurrency/cpu.py) — uncomment to
# pin explicit values instead.
APPLICATION_DATA_POOL_MIN_SIZE=2
APPLICATION_DATA_POOL_MAX_SIZE=4

# Application state store (users/keys/logs/traces/cache/audit) pool sizing.
# Same PostgreSQL database as above, through a separate connection pool.
# Unset = CPU-derived, same as above.
APPLICATION_STATE_POOL_MIN_SIZE=2
APPLICATION_STATE_POOL_MAX_SIZE=4

# Thread-pool sizes backing each pool above. Unset = pool_max + 2.
# APPLICATION_DATA_EXECUTOR_WORKERS=
# APPLICATION_STATE_EXECUTOR_WORKERS=
# BACKGROUND_EXECUTOR_WORKERS=

# =============================================================================
# Auth / JWT
# =============================================================================

# REQUIRED — no hardcoded default; the app refuses to start without this.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=1bd82f0b9d014f97cbebec96908b083a4cef2d5a474b1b2189e3cd4396945579

JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# Per-IP sliding-window rate limiting on /api/auth/users/login and
# /api/auth/users/register.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60.0

# =============================================================================
# Initial admin bootstrap (core/storage/application_state_store.py,
# bootstrap_admin.py)
# =============================================================================

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@salesinfo-info.local
# REQUIRED to auto-create the admin user on startup. Leave unset to skip
# bootstrap and create an admin later via bootstrap_admin.py instead.
INITIAL_ADMIN_PASSWORD=Mudassir@123

# =============================================================================
# App / server
# =============================================================================

APP_NAME=preparedata
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list, or "*" for any origin (only valid when
# CORS_ALLOW_CREDENTIALS=false).
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# Query execution policy
# =============================================================================

REQUIRE_WRITE_SCOPE_FOR_MUTATIONS=true
MAX_RESULT_ROWS=10000
MAX_RESULT_BYTES=10485760
MAX_QUERY_DURATION_SECONDS=30.0
CACHE_INVALIDATION_PRECISE=true

# Per-query-class concurrency caps. Unset = CPU-derived.
# FAST_QUERY_CONCURRENCY_LIMIT=
# NORMAL_QUERY_CONCURRENCY_LIMIT=
# EXPENSIVE_QUERY_CONCURRENCY_LIMIT=

# =============================================================================
# Performance subsystem (core/performance/*) — profiling, resource
# collectors, OTel export. All optional; disabled by default.
# =============================================================================

PERF_ENABLED=true
PERF_SAMPLE_RATE_PERCENT=100
PERF_MAX_TRACE_NODES=10000
PERF_MAX_REQUEST_HISTORY=1000

PERF_ADAPTIVE_SAMPLING=false
PERF_TARGET_SAMPLES_PER_SECOND=5.0
PERF_MIN_SAMPLE_RATE_PERCENT=1.0
PERF_MAX_SAMPLE_RATE_PERCENT=100.0
PERF_SLOW_REQUEST_THRESHOLD_SECONDS=2.0
PERF_ESCALATION_SECONDS=30.0

# Bridge core.performance's registry onto OpenTelemetry on an interval.
# Only takes effect when PERF_ENABLED=true.
PERF_EXPORT_OTEL=false
PERF_OTEL_EXPORT_INTERVAL_SECONDS=15

# Standard OTel SDK var (not read directly by this app's code, but honored
# by the opentelemetry SDK/exporter under the hood) — where traces/metrics
# get shipped. Points at the otel-config.yaml collector in this repo.
# Leave unset (or run the collector) to avoid the periodic
# "Transient error ... exporting traces" retry log noise.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Note: host/port are NOT env-configurable — `python run_api.py` hardcodes
# 127.0.0.1:8000 in its own `uvicorn.run(...)` call. To bind elsewhere, run
# `uvicorn run_api:app --host <host> --port <port>` instead.
#
OTEL_SDK_DISABLED=true
